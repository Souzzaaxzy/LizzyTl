# Token do bot do Telegram (obtido com o @BotFather). Obrigatório.
TELEGRAM_BOT_TOKEN=

# Caminho do GIF do menu principal. Pode ser relativo à raiz do projeto ou absoluto.
START_GIF_PATH=assets/start.gif

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# Diretório de dados locais privados (futuras sessões do WhatsApp). Não versionado.
DATA_DIR=data
