# Token do bot do Telegram (obtido com o @BotFather). Obrigatório.
TELEGRAM_BOT_TOKEN=

# Caminho da mídia do menu principal. Pode ser relativo à raiz do projeto ou absoluto.
START_MEDIA_PATH=assets/start.mp4

# ID numérico do dono do bot. Opcional: o valor padrão já está no código.
# O dono recebe o plano "Dono" no perfil e é isento do limite de taxa.
OWNER_TELEGRAM_ID=

# Proteção contra abuso: máximo de ações por usuário dentro da janela.
# O dono é isento. Valores inválidos caem no padrão.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# Diretório de dados locais privados (usuários, cache de mídia, sessões). Não versionado.
DATA_DIR=data

# WhatsApp (opcional). Sem WHATSAPP_NUMBER, o WhatsApp fica desligado.
# Número com código do país, só dígitos. Ex.: 5511999999999
WHATSAPP_NUMBER=

# Código de pareamento: exatamente 8 caracteres do alfabeto que o WhatsApp
# aceita (123456789ABCDEFGHJKLMNPQRSTVWXYZ — sem I, O, L nem símbolos).
WHATSAPP_PAIRING_CODE=L1ZZYB9T
